{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "profilephototesting",
  "main": "src/index.js",
  "compatibility_date": "2026-11-22",
  "vars": {
    "FIREBASE_PROJECT_ID": "ieee-b6bf8",
    "ALLOWED_ORIGINS": "http://localhost:5173"
  },
  "r2_buckets": [
    {
      "binding": "PHOTOS",
      "bucket_name": "profile-photos-test"
    }
  ]
}
