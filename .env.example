# ==========================================
# IEEE NMAMIT Web Application Environment Config
# ==========================================

# Server Listening Port (Default: 5000)
PORT=5000

# Environment Mode: 'production' or 'development'
NODE_ENV=production

# Node libuv worker threadpool size for concurrent crypto/bcrypt operations
UV_THREADPOOL_SIZE=64

# ==========================================
# PostgreSQL Database & Connection Pooling
# ==========================================
# Option 1: Connection URL (recommended for managed databases like AWS RDS, Supabase, Neon)
DATABASE_URL=postgresql://postgres:password@localhost:5432/ieee_website

# Option 2: Individual Connection Parameters (used if DATABASE_URL is not set)
PGHOST=localhost
PGPORT=5432
PGDATABASE=ieee_website
PGUSER=postgres
PGPASSWORD=postgres

# Connection Pool Sizing Configuration
# Formula: pool_size = floor((DB_MAX_CONNECTIONS - DB_RESERVED_CONNECTIONS) / TOTAL_WORKERS)
# PostgreSQL default max_connections is typically 100.
DB_MAX_CONNECTIONS=100
DB_RESERVED_CONNECTIONS=5
BACKEND_WORKERS=1
DB_POOL_MAX=20
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECT_TIMEOUT_MS=5000

# ==========================================
# Authentication & Security
# ==========================================
# JSON Web Token Secret Keys
JWT_SECRET=replace_with_a_long_random_cryptographic_secret_key_32_bytes_min
JWT_EXPIRES_IN=1h

JWT_REFRESH_SECRET=replace_with_a_separate_cryptographic_refresh_secret_key
JWT_REFRESH_EXPIRES_IN=7d

# Optional Redis Instance / Cluster URL (e.g. redis://default:password@localhost:6379)
# If omitted or offline, the server automatically defaults to high-speed in-memory LRU/TTL caching.
REDIS_URL=

# CORS Whitelist (Comma-separated origins, or '*' for public access)
CORS_ORIGIN=*
